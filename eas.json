{
  "cli": {
    "requireCommit": false
  },
  "build": {
    "development-simulator": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "android": {
        "credentialsSource": "local"
      }
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "credentialsSource": "local"
      }
    },
    "preview": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "credentialsSource": "local"
      },
      "env": {
        "ALCHEMY_API_KEY": "ALCHEMY_API_KEY",
        "GAS_MANAGER_POLICY_ID": "GAS_MANAGER_POLICY_ID",
        "PIMLICO_API_KEY": "PIMLICO_API_KEY",
        "TURNKEY_ORGANIZATION_ID": "TURNKEY_ORGANIZATION_ID",
        "TURNKEY_API_PUBLIC_KEY": "TURNKEY_API_PUBLIC_KEY",
        "TURNKEY_API_PRIVATE_KEY": "TURNKEY_API_PRIVATE_KEY",
        "API_BASE_URL": "API_BASE_URL",
        "EXPO_PUBLIC_PASSKEY_RP_NAME": "Kokio.app",
        "EXPO_PUBLIC_RP_ID": "docs.kokio.app",
        "EXPO_PUBLIC_TURNKEY_API_URL": "https://api.turnkey.com"
      }
    },
    "production": {}
  }
}

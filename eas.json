{
  "cli": {
    "requireCommit": false
  },
  "build": {
    "development-simulator": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "android": {
        "credentialsSource": "local"
      }
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "credentialsSource": "local"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "credentialsSource": "local"
      },
      "env": {
        "EXPO_PUBLIC_ALCHEMY_API_KEY":"EXPO_PUBLIC_ALCHEMY_API_KEY",
        "EXPO_PUBLIC_GAS_MANAGER_POLICY_ID":"EXPO_PUBLIC_GAS_MANAGER_POLICY_ID",
        "EXPO_PUBLIC_PIMLICO_API_KEY":"EXPO_PUBLIC_PIMLICO_API_KEY",
        "EXPO_PUBLIC_PASSKEY_RP_NAME":"EXPO_PUBLIC_PASSKEY_RP_NAME",
        "EXPO_PUBLIC_RP_ID":"EXPO_PUBLIC_RP_ID",
        "EXPO_PUBLIC_TURNKEY_API_URL":"EXPO_PUBLIC_TURNKEY_API_URL",
        "EXPO_PUBLIC_TURNKEY_ORGANIZATION_ID":"EXPO_PUBLIC_TURNKEY_ORGANIZATION_ID",
        "EXPO_PUBLIC_TURNKEY_API_PUBLIC_KEY":"EXPO_PUBLIC_TURNKEY_API_PUBLIC_KEY",
        "EXPO_PUBLIC_TURNKEY_API_PRIVATE_KEY":"EXPO_PUBLIC_TURNKEY_API_PRIVATE_KEY",
        "EXPO_PUBLIC_API_BASE_URL":"EXPO_PUBLIC_API_BASE_URL"
      }
    },
    "production": {}
  }
}
